{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paddockloom",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-25",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/studio*", "/catalogue.json", "/__studio/*", "/images/upload-*", "/admin", "/admin/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "paddockloom-catalogue",
    "database_id": "27d316ef-be0d-4724-ac07-66f5477458e6",
    "migrations_dir": "worker/migrations"
  }],
  "observability": { "enabled": false }
}
